# FLIRT independent backend. Supply new credentials; never copy Twin .env files.
# This branch is provisioning preparation and deliberately refuses live startup.
FLIRT_BACKEND_ENABLED=false
FLIRT_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Use separate FLIRT-owned accounts or billing projects for these services.
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_APP_NAME=FLIRT
# Leave attribution URL empty unless public model-usage attribution is intended.
OPENROUTER_APP_URL=

# New random secrets, different for creator and operator sessions (32+ chars).
DASHBOARD_SESSION_SECRET=
CREATOR_SESSION_SECRET=
DASHBOARD_PASSWORD=
# Explicit FLIRT preview/deployment origin. No Twin production fallback.
DASHBOARD_PUBLIC_ORIGIN=
COMPILER_MODEL=
