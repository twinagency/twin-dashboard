# Copy to .env (local dev) or supply as real environment variables / secrets
# when deploying (see DOCKER.md). Never commit an .env with real values.

# ── Supabase (same project the bot uses) ─────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ── Dashboard login ───────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=
# Random 32+ byte secret, e.g.: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=

# ── LLM (persona compiler on the Settings/Clones pages) ──────────────────────
OPENROUTER_API_KEY=
# Optional, defaults to openai/gpt-4.1
COMPILER_MODEL=
NODE_ENV=
