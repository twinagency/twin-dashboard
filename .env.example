# FLIRT white label, powered by the existing Twin service accounts.
# Only database, login/session and application identity settings are FLIRT-specific.
# This branch is provisioning preparation and deliberately refuses live startup.
FLIRT_BACKEND_ENABLED=false
FLIRT_SUPABASE_PROJECT_REF=lkmfwpqegjluirfusnaw
SUPABASE_URL=https://lkmfwpqegjluirfusnaw.supabase.co
SUPABASE_SERVICE_KEY=
# Public key for recovery only. Validated and passed by the server at runtime.
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Reuse the authorised Twin service keys. New provider accounts are not required.
# Either inject these values using the host secret manager, or mount the optional
# allowlisted JSON file with deployment/compose.shared-services.yml.
FLIRT_SHARED_SERVICES_FILE=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_APP_NAME=FLIRT
# Leave attribution URL empty unless public model-usage attribution is intended.
OPENROUTER_APP_URL=

# New random secrets, different for creator and operator sessions (32+ chars).
DASHBOARD_SESSION_SECRET=
CREATOR_SESSION_SECRET=
DASHBOARD_PASSWORD=
# Explicit FLIRT preview/deployment origin. No Twin production fallback.
DASHBOARD_PUBLIC_ORIGIN=
COMPILER_MODEL=

# Optional operator-only access to Jesse's four existing live Twin creators.
# Creator signup/auth and the FLIRT bot retain the separate FLIRT project.
FLIRT_LIVE_TWIN_ENABLED=false
FLIRT_LIVE_TWIN_URL=
FLIRT_LIVE_TWIN_SERVICE_KEY=

