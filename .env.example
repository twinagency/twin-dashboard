# Copy to .env (local dev) or supply as real environment variables / secrets
# when deploying (see DOCKER.md). Never commit an .env with real values.

# ── Supabase (same project the bot uses) ─────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Optional / not currently used: the app only talks to Supabase over the REST
# API (supabase-js), which Supabase pools for you server-side — there's
# nothing to configure for that path. Set this only if some future code needs
# a direct Postgres connection (a migration runner, an ORM, a one-off script);
# point it at the Supavisor pooler (Project Settings → Database → Connection
# pooling), not the DB directly, so many short-lived container instances don't
# exhaust Postgres' connection limit. Transaction mode (port 6543) is right for
# serverless/short-lived queries; use session mode (5432) only if you need
# session-level features like prepared statements.
# DATABASE_URL=postgresql://postgres.aouaenqayfltoqrmpitg:[db-password]@[pooler-host from Supabase dashboard]:6543/postgres?pgbouncer=true

# ── Dashboard login ───────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=
# Random 32+ byte secret, e.g.: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=

# ── LLM (persona compiler on the Settings/Clones pages) ──────────────────────
OPENROUTER_API_KEY=
# Optional, defaults to openai/gpt-4.1
COMPILER_MODEL=
NODE_ENV=

# ── Sim page (/sim) ───────────────────────────────────────────────────────────
# Where the twinsim matrix runner (../bot/src/dev/twinsim, `npm run twinsim`)
# is reachable from a browser viewing this dashboard. It's a separate process
# this dashboard does not start — point this at wherever it's running.
# Optional, defaults to http://127.0.0.1:4200
TWINSIM_URL=
